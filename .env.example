# Export configuration explicitly; this project does not load .env automatically.
# Use the standard AWS credential chain. Do not put credentials in this file.
AWS_PROFILE=your-project-profile
AWS_DEFAULT_REGION=us-east-1
BEDROCK_MODEL_ID=amazon.nova-micro-v1:0
AGENT_MAX_REQUESTS=5
AGENT_MAX_TOOL_CALLS=5
AGENT_MAX_OUTPUT_TOKENS=1024
AGENT_REQUEST_TIMEOUT_SECONDS=15
CHAT_TIMEOUT_SECONDS=60

# Catalog location relative to the repository root. Pass it explicitly to the
# import command's --database argument; this file is not loaded automatically.
DATABASE_PATH=data/catalog.sqlite3
