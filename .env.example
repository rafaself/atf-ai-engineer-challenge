# Copy to .env and choose ONE AWS authentication option below.
# Keep real credentials only in the Git-ignored .env, never in this example.
# The application does not load .env automatically. From the repository root:
# uv run --env-file .env --project apps/backend --locked uvicorn emporio_music_backend.api.app:create_app --factory --host 127.0.0.1 --port 8000
# Existing shell environment variables take precedence over .env values.

# Option 1: a configured AWS profile (including SSO).
# AWS_PROFILE=your-project-profile

# Option 2: access keys; uncomment and fill in the values in your local .env.
# Remove AWS_PROFILE from .env and unset AWS_PROFILE/AWS_DEFAULT_PROFILE in
# your shell when using this option. Prefer temporary, narrowly scoped credentials.
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# Required for temporary credentials; omit for long-lived access keys:
# AWS_SESSION_TOKEN=your-session-token

# If neither option is set, boto3 uses its standard default credential chain.
AWS_DEFAULT_REGION=us-east-1
BEDROCK_MODEL_ID=qwen.qwen3-32b-v1:0
AGENT_MAX_REQUESTS=5
AGENT_MAX_TOOL_CALLS=5
AGENT_MAX_OUTPUT_TOKENS=1024
AGENT_REQUEST_TIMEOUT_SECONDS=15
CHAT_TIMEOUT_SECONDS=60
HISTORY_MAX_TURNS=6
HISTORY_MAX_CHARACTERS=24000

# Guest chat needs no identity configuration. To demonstrate orders, send an
# existing fictional customer_id in the HTTP body. This is not authentication.
# Keep the server on loopback and use fictional data only.

# Opt-in terminal diagnostics: metadata, counts, timing and safe error classes only.
# Raw messages, answers, history, customer IDs, tokens and tool rows are excluded.
PIPELINE_LOGS=0

# Storage is fixed by emporio_music_backend.paths under PROJECT_ROOT / "data":
# catalog.sqlite3, operations.sqlite3 and conversations.sqlite3.
# There are no environment variables for storage paths.
