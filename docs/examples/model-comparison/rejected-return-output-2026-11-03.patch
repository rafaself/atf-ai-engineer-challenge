@@ -0,0 +1,231 @@
+"""Render a bounded online-return answer from fresh policy and reported facts."""
+
+from typing import Any, Literal, cast
+
+from pydantic_ai import ModelRetry, RunContext
+from pydantic_ai.messages import ToolReturnPart
+
+from emporio_music_backend.contracts.conversations import ExecutionContext
+from emporio_music_backend.contracts.orders import DatabaseId
+from emporio_music_backend.contracts.policies import OnlineReturnRule
+from emporio_music_backend.contracts.returns import OnlineReturnFacts, ReturnFactName
+
+_QUESTIONS = {
+    "online_purchase": "A compra foi feita online?",
+    "days_since_receipt": "Há quantos dias corridos você recebeu o produto de fato?",
+    "original_packaging": "O produto está na embalagem original?",
+    "no_signs_of_use": "O produto está sem sinais de uso?",
+    "all_accessories": "Todos os acessórios estão presentes?",
+    "all_manuals": "Todos os manuais estão presentes?",
+    "customized_or_custom_setup": "Houve personalização ou ajuste sob encomenda?",
+    "clearance_explicit_final_sale": "A compra foi de liquidação com aviso explícito de venda final?",
+    "wind_instrument_mouthpiece": "O item é uma boquilha de instrumento de sopro?",
+}
+
+_LABELS = {
+    "original_packaging": "embalagem original",
+    "no_signs_of_use": "ausência de sinais de uso",
+    "all_accessories": "todos os acessórios",
+    "all_manuals": "todos os manuais",
+    "customized_or_custom_setup": "personalização ou ajuste sob encomenda",
+    "clearance_explicit_final_sale": "liquidação com aviso explícito de venda final",
+    "wind_instrument_mouthpiece": "item ser boquilha de instrumento de sopro",
+}
+
+
+def render_online_return(rule: OnlineReturnRule, facts: OnlineReturnFacts) -> str:
+    """Decide only this documented rule; do not invent an operational workflow."""
+    days = facts.days_since_receipt
+    deadline = rule["request_deadline_calendar_days_after_receipt"]
+    if facts.online_purchase is False:
+        return "Esta regra de arrependimento se aplica a compras online. Para avaliar uma compra presencial, precisamos consultar a política correspondente ao seu caso."
+    if days is not None and days > deadline:
+        return f"Você informou recebimento há {days} dias corridos. Isso ultrapassa o prazo de {deadline} dias desta regra de arrependimento para compras online. Isso não determina se outra regra, como a de defeito, se aplica."
+    prefix = (
+        f"Você informou recebimento há {days} dias corridos, dentro do prazo de {deadline} dias para solicitar devolução por arrependimento em compra online."
+        if days is not None
+        else f"Para compras online, o prazo para solicitar devolução por arrependimento é de até {deadline} dias corridos após o recebimento real, sem espera mínima."
+    )
+    unmet = [
+        key
+        for key in rule["required_customer_facts"]
+        if key != "actual_receipt_date" and getattr(facts, key) is False
+    ]
+    exclusions = [
+        key
+        for key in rule["excluded_product_conditions"]
+        if getattr(facts, key) is True
+    ]
+    if unmet or exclusions:
+        reasons = []
+        if unmet:
+            reasons.append(
+                "Condições não atendidas: "
+                + ", ".join(_LABELS[key] for key in unmet)
+                + "."
+            )
+        if exclusions:
+            reasons.append(
+                "Exclusões informadas: "
+                + ", ".join(_LABELS[key] for key in exclusions)
+                + "."
+            )
+        return (
+            prefix
+            + "\n\n"
+            + "\n".join(reasons)
+            + " Isso não determina se outra política se aplica."
+        )
+    needed = [
+        "days_since_receipt" if key == "actual_receipt_date" else key
+        for key in rule["required_customer_facts"]
+    ]
+    needed.extend(rule["excluded_product_conditions"])
+    missing = [key for key in needed if getattr(facts, key) is None]
+    if missing:
+        questions = [
+            _QUESTIONS[key]
+            for key in missing
+            if key not in rule["excluded_product_conditions"]
+            and key not in {"all_accessories", "all_manuals"}
+        ]
+        if "all_accessories" in missing and "all_manuals" in missing:
+            questions.append("Todos os acessórios e manuais estão presentes?")
+        else:
+            questions.extend(
+                _QUESTIONS[key]
+                for key in ("all_accessories", "all_manuals")
+                if key in missing
+            )
+        unknown_exclusions = [
+            key for key in rule["excluded_product_conditions"] if key in missing
+        ]
+        if unknown_exclusions:
+            questions.append(
+                "Confirme se alguma destas exclusões se aplica: "
+                + "; ".join(_LABELS[key] for key in unknown_exclusions)
+                + "."
+            )
+        return (
+            prefix
+            + "\n\nAinda preciso confirmar estes pontos antes de concluir a elegibilidade:\n"
+            + "\n".join(f"- {question}" for question in questions)
+        )
+    refund = rule["refund_information"]
+    return prefix + (
+        "\n\nCom os fatos que você informou, os critérios desta regra estão atendidos. "
+        "Você pode solicitar a devolução. O manual informa reembolso na mesma forma de pagamento "
+        f"original em até {refund['deadline_business_days']} dias úteis, com frete de devolução por conta da loja."
+    )
+
+
+def answer_online_return(
+    ctx: RunContext[ExecutionContext],
+    customer_facts: OnlineReturnFacts,
+    order_id: DatabaseId | None = None,
+    request_kind: Literal["eligibility", "procedure"] = "eligibility",
+) -> str:
+    """Finish an online-return eligibility answer using fresh scoped policy.
+
+    Call search_store_policies(policy_scope='online_return') in this run first.
+    Use null for unknown customer facts. Every known fact requires evidence with
+    an exact quote from a user message; never quote assistant text as evidence.
+    Omit order_id unless get_my_order returned it in THIS run, not a prior turn.
+    This output function renders the answer; do not add a free-text procedure.
+    For return contacts, initiation or labels choose request_kind=procedure;
+    the renderer states the documented limit instead of inventing a workflow.
+    """
+    policy: OnlineReturnRule | None = None
+    fresh_scope_read = False
+    orders: dict[int, dict[str, Any]] = {}
+    for message in ctx.messages:
+        if message.run_id != ctx.run_id:
+            continue
+        for part in message.parts:
+            if not isinstance(part, ToolReturnPart) or not isinstance(
+                part.content, dict
+            ):
+                continue
+            if (
+                part.tool_name == "search_store_policies"
+                and part.content.get("policy_scope") == "online_return"
+            ):
+                fresh_scope_read = True
+                records = part.content.get("records", [])
+                if not isinstance(records, list):
+                    continue
+                for record in records:
+                    if isinstance(record, dict) and record.get("section") == "4.1":
+                        policy = record.get("online_return_rule")
+            if part.tool_name == "get_my_order":
+                candidate = part.content.get("order")
+                if isinstance(candidate, dict) and isinstance(
+                    candidate.get("order_id"), int
+                ):
+                    orders[candidate["order_id"]] = candidate
+    if policy is None and fresh_scope_read:
+        return "A evidência desta consulta não permite avaliar esta devolução pela regra de compras online. Não posso confirmar elegibilidade sem a política aplicável."
+    if policy is None:
+        raise ModelRetry(
+            "Retrieve search_store_policies(policy_scope='online_return') in this run before answering."
+        )
+    if request_kind == "procedure":
+        if policy["documented_next_steps"]:
+            return (
+                "Esta consulta não emite etiquetas nem inicia devoluções. "
+                "A regra consultada documenta estes passos:\n"
+                + "\n".join(f"- {step}" for step in policy["documented_next_steps"])
+            )
+        return (
+            "Esta consulta pode explicar as regras, mas não emite etiquetas nem inicia devoluções. "
+            "A regra consultada informa que o frete de devolução por arrependimento fica por conta da loja; "
+            "ela não documenta contato específico para devoluções ou procedimento de postagem."
+        )
+    user_texts = [m.content for m in ctx.deps.history if m.role == "user"]
+    if isinstance(ctx.prompt, str):
+        user_texts.append(ctx.prompt)
+    unsupported_facts: dict[str, None] = {}
+    for key, value in customer_facts.model_dump(exclude={"evidence"}).items():
+        if value is None:
+            continue
+        quote = customer_facts.evidence.get(cast(ReturnFactName, key))
+        if not quote or not any(quote in text for text in user_texts):
+            # Unsupported extractions remain unknown; never certify them or
+            # turn an omitted quote into an HTTP failure.
+            unsupported_facts[key] = None
+    answer = render_online_return(
+        policy, customer_facts.model_copy(update=unsupported_facts)
+    )
+    if order_id is None and len(orders) == 1:
+        order_id = next(iter(orders))
+    elif order_id is None and len(orders) > 1:
+        answer = (
+            "Para apresentar detalhes de um pedido, preciso que você indique qual dos pedidos consultados deseja.\n\n"
+            + answer
+        )
+    if order_id is not None:
+        order = orders.get(order_id)
+        if order is None:
+            return (
+                "Não consultei os detalhes atuais desse pedido neste turno.\n\n"
+                + answer
+            )
+        status = {
+            "pending": "pendente",
+            "confirmed": "confirmado",
+            "shipped": "enviado",
+            "delivered": "entregue",
+            "cancelled": "cancelado",
+        }[order["status"]]
+        total = str(order["total_brl"]).replace(".", ",")
+        details = [f"Pedido {order_id}: status {status}; total R$ {total}."]
+        for item in order.get("items", []):
+            details.append(f"- {item['quantity']} × {item['product_name']}")
+        if order.get("tracking_code"):
+            details.append(f"Rastreio: {order['tracking_code']}.")
+        if order.get("estimated_delivery"):
+            details.append(
+                f"Previsão de entrega: {order['estimated_delivery']} (não é confirmação de recebimento real)."
+            )
+        answer = "\n".join(details) + "\n\n" + answer
+    return answer
