+def test_http_followup_refreshes_scope_and_preserves_reported_facts(
+    tmp_path: Path,
+) -> None:
+    from fastapi.testclient import TestClient
+
+    from emporio_music_backend.api.app import create_app
+    from emporio_music_backend.application.chat import ChatService
+    from emporio_music_backend.infrastructure.conversations import (
+        SQLiteConversationRepository,
+    )
+
+    policy = PreparedSearch()
+
+    def respond(messages: list[ModelMessage], info: AgentInfo) -> ModelResponse:
+        current_policy = any(
+            isinstance(part, ToolReturnPart)
+            and part.tool_name == "search_store_policies"
+            for message in messages
+            for part in message.parts
+        )
+        if not current_policy:
+            return ModelResponse(
+                parts=[
+                    ToolCallPart(
+                        "search_store_policies", {"policy_scope": "online_return"}
+                    )
+                ]
+            )
+        question = next(
+            part.content
+            for message in reversed(messages)
+            for part in message.parts
+            if isinstance(part, UserPromptPart)
+        )
+        facts = (
+            {
+                "online_purchase": True,
+                "days_since_receipt": 5,
+                "evidence": {
+                    "online_purchase": "Foi compra online",
+                    "days_since_receipt": "recebi há cinco dias",
+                },
+            }
+            if "cinco dias" in question
+            else {"evidence": {}}
+        )
+        return ModelResponse(
+            parts=[ToolCallPart("answer_online_return", {"customer_facts": facts})]
+        )
+
+    agent = create_store_agent(
+        AgentSettings(),
+        UnusedProducts(),
+        UnusedOrders(),
+        model=FunctionModel(respond),
+        policy_search=policy,
+    )
+    service = ChatService(
+        agent, SQLiteConversationRepository(tmp_path / "chat.sqlite3")
+    )
+    with TestClient(create_app(service)) as client:
+        first = client.post("/api/chat", json={"message": "Posso devolver uma compra?"})
+        assert first.status_code == 200
+        second = client.post(
+            "/api/chat",
+            json={
+                "message": "Foi compra online e recebi há cinco dias. Posso devolver?",
+                "session_id": first.json()["session_id"],
+            },
+        )
+    assert second.status_code == 200
+    answer = second.json()["answer"]
+    assert "dentro do prazo de 7" in answer
+    assert "antes de concluir a elegibilidade" in answer
+    assert "A compra foi feita online?" not in answer
+    assert "Há quantos dias" not in answer
+    assert "etiqueta" not in answer
+    assert policy.calls == ["online_return", "online_return"]
+
