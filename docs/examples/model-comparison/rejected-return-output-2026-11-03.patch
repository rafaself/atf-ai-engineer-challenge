+"""Return deadlines, evidence boundaries and bounded final-answer rendering."""
+
+import asyncio
+from pathlib import Path
+
+import pytest
+from pydantic import ValidationError
+from pydantic_ai import ModelRetry, RunContext
+from pydantic_ai.messages import (
+    ModelMessage,
+    ModelRequest,
+    ModelResponse,
+    TextPart,
+    ToolCallPart,
+    ToolReturnPart,
+    UserPromptPart,
+)
+from pydantic_ai.models.function import AgentInfo, FunctionModel
+from pydantic_ai.models.test import TestModel
+from pydantic_ai.usage import RunUsage
+
+from emporio_music_backend.agent.orders import create_store_agent
+from emporio_music_backend.agent.return_answer import (
+    answer_online_return,
+    render_online_return,
+)
+from emporio_music_backend.agent.settings import AgentSettings
+from emporio_music_backend.contracts.catalog import (
+    ProductSearchQuery,
+    ProductSearchResult,
+)
+from emporio_music_backend.contracts.chat import ChatRequest
+from emporio_music_backend.contracts.conversations import (
+    ConversationMessage,
+    ConversationSession,
+    ExecutionContext,
+)
+from emporio_music_backend.contracts.identity import CustomerIdentity
+from emporio_music_backend.contracts.orders import (
+    OrderDetail,
+    OrderListQuery,
+    OrderListResult,
+    OrderLookupQuery,
+)
+from emporio_music_backend.contracts.policies import (
+    OnlineReturnRule,
+    PolicyExcerpt,
+    PolicyScope,
+    PolicySearchResult,
+)
+from emporio_music_backend.contracts.returns import OnlineReturnFacts
+from emporio_music_backend.paths import DATA_DIRECTORY
+from emporio_music_backend.policy_corpus import prepare
+
+
+def prepared_rule() -> OnlineReturnRule:
+    rule = next(
+        c
+        for c in prepare(DATA_DIRECTORY / "store_policies.pdf").chunks
+        if c.section == "4.1"
+    ).online_return_rule
+    assert rule is not None
+    return rule
+
+
+@pytest.mark.parametrize("days", [0, 5, 7])
+def test_deadline_is_inclusive_and_unknown_conditions_block_eligibility(
+    days: int,
+) -> None:
+    answer = render_online_return(
+        prepared_rule(),
+        OnlineReturnFacts(online_purchase=True, days_since_receipt=days, evidence={}),
+    )
+    assert f"há {days} dias corridos, dentro do prazo de 7" in answer
+    assert "antes de concluir a elegibilidade" in answer
+    assert "Você pode solicitar a devolução" not in answer
+    assert "embalagem original" in answer and "sinais de uso" in answer
+    assert "etiqueta" not in answer and "@" not in answer
+
+
+def test_day_eight_is_outside_this_window_without_denying_other_policies() -> None:
+    answer = render_online_return(
+        prepared_rule(),
+        OnlineReturnFacts(online_purchase=True, days_since_receipt=8, evidence={}),
+    )
+    assert "ultrapassa o prazo de 7 dias" in answer
+    assert "outra regra" in answer
+
+
+def test_complete_reported_facts_can_satisfy_only_the_documented_rule() -> None:
+    facts = OnlineReturnFacts(
+        evidence={},
+        online_purchase=True,
+        days_since_receipt=7,
+        original_packaging=True,
+        no_signs_of_use=True,
+        all_accessories=True,
+        all_manuals=True,
+        customized_or_custom_setup=False,
+        clearance_explicit_final_sale=False,
+        wind_instrument_mouthpiece=False,
+    )
+    answer = render_online_return(prepared_rule(), facts)
+    assert "Com os fatos que você informou" in answer
+    assert "Você pode solicitar a devolução" in answer
+    assert "10 dias úteis" in answer
+    assert "centro de distribuição" not in answer and "etiqueta" not in answer
+    assert "lacrada" not in answer and "documentos" not in answer
+
+
+def test_return_schema_has_no_free_procedure_or_contact_field() -> None:
+    with pytest.raises(ValidationError, match="extra_forbidden"):
+        OnlineReturnFacts.model_validate({"contact": "invented@example.com"})
+
+
+def test_return_output_requires_fresh_policy_not_previous_assistant_prose() -> None:
+    context = RunContext(
+        deps=ExecutionContext(),
+        model=TestModel(),
+        usage=RunUsage(),
+        prompt="Recebi há cinco dias",
+        run_id="current",
+        messages=[],
+    )
+    with pytest.raises(ModelRetry, match="in this run"):
+        answer_online_return(context, OnlineReturnFacts(evidence={}))
+
+
+def test_insufficient_scoped_evidence_gives_no_eligibility_decision() -> None:
+    context = RunContext(
+        deps=ExecutionContext(),
+        model=TestModel(),
+        usage=RunUsage(),
+        run_id="current",
+        messages=[
+            ModelRequest(
+                run_id="current",
+                parts=[
+                    ToolReturnPart(
+                        "search_store_policies",
+                        {
+                            "policy_scope": "online_return",
+                            "status": "insufficient_evidence",
+                            "records": [],
+                        },
+                    )
+                ],
+            )
+        ],
+    )
+    answer = answer_online_return(context, OnlineReturnFacts(evidence={}))
+    assert "Não posso confirmar elegibilidade" in answer
+    assert "Você pode solicitar" not in answer
+
+
+def test_procedure_response_has_no_invented_contact_or_action() -> None:
+    context = RunContext(
+        deps=ExecutionContext(),
+        model=TestModel(),
+        usage=RunUsage(),
+        run_id="current",
+        messages=[
+            ModelRequest(
+                run_id="current",
+                parts=[
+                    ToolReturnPart(
+                        "search_store_policies",
+                        {
+                            "policy_scope": "online_return",
+                            "records": [
+                                {
+                                    "section": "4.1",
+                                    "online_return_rule": prepared_rule(),
+                                }
+                            ],
+                        },
+                    )
+                ],
+            )
+        ],
+    )
+    answer = answer_online_return(
+        context, OnlineReturnFacts(evidence={}), request_kind="procedure"
