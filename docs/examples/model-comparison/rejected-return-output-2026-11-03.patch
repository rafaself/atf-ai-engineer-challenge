@@ -0,0 +1,58 @@
+"""Customer-reported online-return facts, with evidence rather than free prose."""
+
+from collections.abc import Mapping
+from typing import Annotated, Literal
+
+from pydantic import Field, StrictBool, field_validator
+
+from emporio_music_backend.contracts.base import ContractModel, NonblankText
+
+ReturnFactName = Literal[
+    "online_purchase",
+    "days_since_receipt",
+    "original_packaging",
+    "no_signs_of_use",
+    "all_accessories",
+    "all_manuals",
+    "customized_or_custom_setup",
+    "clearance_explicit_final_sale",
+    "wind_instrument_mouthpiece",
+]
+
+
+class OnlineReturnFacts(ContractModel):
+    """Unknown facts stay null. Every known fact needs an exact customer quote.
+
+    Quotes establish where the extraction came from, not its semantic correctness.
+    Never infer physical condition from delivered status or product names.
+    """
+
+    online_purchase: StrictBool | None = None
+    days_since_receipt: Annotated[int, Field(strict=True, ge=0, le=36500)] | None = None
+    original_packaging: StrictBool | None = None
+    no_signs_of_use: StrictBool | None = None
+    all_accessories: StrictBool | None = None
+    all_manuals: StrictBool | None = None
+    customized_or_custom_setup: StrictBool | None = None
+    clearance_explicit_final_sale: StrictBool | None = None
+    wind_instrument_mouthpiece: StrictBool | None = None
+    evidence: dict[ReturnFactName, NonblankText] = Field(
+        default_factory=dict,
+        description=(
+            "For every non-null fact, include the SAME field name "
+            "mapped to an exact quote from a user message. Use {} only when all "
+            "facts are unknown. Schema text is never customer evidence."
+        ),
+    )
+
+    @field_validator("evidence", mode="before")
+    @classmethod
+    def retain_text_quotes(cls, value: object) -> dict[str, str]:
+        """Malformed quote entries establish no customer facts."""
+        if not isinstance(value, Mapping):
+            return {}
+        return {
+            key: quote
+            for key, quote in value.items()
+            if isinstance(key, str) and isinstance(quote, str) and quote.strip()
+        }
