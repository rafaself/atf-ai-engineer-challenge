+class PreparedSearch:
+    def __init__(self) -> None:
+        self.calls: list[PolicyScope] = []
+
+    def search(
+        self, query: str, *, policy_scope: PolicyScope = "general"
+    ) -> PolicySearchResult:
+        assert policy_scope == "online_return"
+        self.calls.append(policy_scope)
+        records: list[PolicyExcerpt] = []
+        for chunk in prepare(DATA_DIRECTORY / "store_policies.pdf").chunks:
+            if chunk.section not in {"4.1", "4.4"}:
+                continue
+            record: PolicyExcerpt = {
+                "id": chunk.id,
+                "source": "store_policies.pdf",
+                "section": chunk.section,
+                "hierarchy": chunk.hierarchy,
+                "pages": chunk.pages,
+                "text": chunk.text,
+            }
+            if chunk.online_return_rule is not None:
+                record["online_return_rule"] = chunk.online_return_rule
+            records.append(record)
+        return {
+            "status": "evidence_found",
+            "records": records,
+            "policy_scope": policy_scope,
+        }
+
+
+class UnusedProducts:
+    def search(self, query: ProductSearchQuery) -> ProductSearchResult:
+        raise AssertionError("Not a catalog question")
+
+
+class UnusedOrders:
+    def list_orders(
+        self, identity: CustomerIdentity, query: OrderListQuery
+    ) -> OrderListResult:
+        raise AssertionError("No order details requested")
+
+    def get_order(
+        self, identity: CustomerIdentity, query: OrderLookupQuery
+    ) -> OrderDetail | None:
+        raise AssertionError("No order details requested")
+
