+def test_scoped_return_rejects_prose_and_treats_omitted_evidence_as_unknown() -> None:
+    calls = 0
+
+    def respond(messages: list[ModelMessage], info: AgentInfo) -> ModelResponse:
+        nonlocal calls
+        calls += 1
+        if calls == 1:
+            return ModelResponse(
+                parts=[
+                    ToolCallPart(
+                        "search_store_policies", {"policy_scope": "online_return"}
+                    )
+                ]
+            )
+        if calls == 2:
+            return ModelResponse(
+                parts=[
+                    TextPart("Escreva para invented@example.com; emitiremos etiqueta.")
+                ]
+            )
+        assert calls == 3
+        assert any(t.name == "answer_online_return" for t in info.output_tools)
+        return ModelResponse(
+            parts=[
+                ToolCallPart(
+                    "answer_online_return",
+                    {
+                        "customer_facts": {
+                            "online_purchase": True,
+                            "days_since_receipt": 5,
+                        }
+                    },
+                )
+            ]
+        )
+
+    agent = create_store_agent(
+        AgentSettings(),
+        UnusedProducts(),
+        UnusedOrders(),
+        model=FunctionModel(respond),
+        policy_search=PreparedSearch(),
+    )
+    answer = asyncio.run(
+        agent.run(
+            ChatRequest(
+                message="Foi compra online e recebi há cinco dias. Posso devolver?"
+            ),
+            context=ExecutionContext(),
+        )
+    ).answer
+    assert calls == 3
+    assert "A compra foi feita online?" in answer
+    assert "Há quantos dias" in answer
+    assert "confirmar" in answer
+    assert "invented@example.com" not in answer and "etiqueta" not in answer
+
